<%- include('../partials/start') %>
<section class="admin-panel">
  <div class="admin-panel__header">
    <h1>Mã giảm giá</h1>
    <a class="btn btn--primary" href="/admin/coupons/new">Tạo mã</a>
  </div>
  <form class="admin-search" method="get" action="/admin/coupons"><label for="coupon-search">Tìm mã</label><input id="coupon-search" name="q" value="<%= q %>" maxlength="50" /><button class="btn" type="submit">Tìm kiếm</button></form>
  <% if(!coupons.length){ %><p>Chưa có mã giảm giá phù hợp.</p><% } else { %><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Mã</th><th>Mức giảm</th><th>Thời gian</th><th>Lượt đang tính / hạn mức</th><th>Còn lại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
    <% for(const c of coupons){ %><tr><td><%= c.code %></td><td><%= c.discount_type==='percent'?c.discount_value+'%':moneyLabel(c.discount_value) %><br />Tối thiểu <%= moneyLabel(c.min_order_amount) %><% if(c.max_discount_amount!=null){ %><br />Giảm tối đa <%= moneyLabel(c.max_discount_amount) %><% } %></td><td><%= c.starts_at %><br /><%= c.ends_at %></td><td><%= c.used_count %> / <%= c.max_uses ?? 'Không giới hạn' %></td><td><%= c.max_uses==null?'Không giới hạn':Math.max(0,Number(c.max_uses)-Number(c.used_count)) %></td><td><%= !Number(c.is_active)?'Vô hiệu hóa':Number(c.not_started)?'Chưa bắt đầu':Number(c.expired)?'Hết hạn':c.max_uses!=null&&Number(c.used_count)>=Number(c.max_uses)?'Hết lượt':'Có thể dùng' %></td><td><a href="/admin/coupons/<%= c.coupon_id %>/edit">Sửa</a> · <a href="/admin/coupons/<%= c.coupon_id %>/orders">Đơn hàng</a><form method="post" action="/admin/coupons/<%= c.coupon_id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="is_active" value="<%= Number(c.is_active)?'0':'1' %>" /><button class="btn" type="submit"><%= Number(c.is_active)?'Vô hiệu hóa':'Kích hoạt' %></button></form></td></tr><% } %>
  </tbody></table></div><% } %>
  <% if(pages){ %><nav class="admin-actions" aria-label="Phân trang mã"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Trang trước</a><% } %><span>Trang <%= page %>/<%= pages %></span><% if(page<pages){ %><a href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Trang sau</a><% } %></nav><% } %>
</section><%- include('../partials/end') %>
