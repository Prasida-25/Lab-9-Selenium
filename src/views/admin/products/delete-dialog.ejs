<dialog class="admin-delete-dialog" data-product-delete-dialog aria-labelledby="product-delete-title">
  <h2 id="product-delete-title">Xóa sản phẩm?</h2>
  <p data-product-delete-message></p>
  <p>Các biến thể và dòng giỏ hàng của khách liên quan cũng sẽ bị xóa.</p>
  <form method="dialog" class="admin-actions">
    <button type="submit" class="btn" value="cancel" autofocus>Hủy</button>
    <button type="submit" class="btn btn--primary" value="delete">Xóa</button>
  </form>
</dialog>
<script src="/js/admin-product-delete.js" defer></script>
