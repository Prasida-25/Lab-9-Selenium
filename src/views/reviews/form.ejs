<%- include('../account/partials/start') %>
<link rel="stylesheet" href="/css/orders.css" />
<section class="orders-page orders-card">
  <h1>Đánh giá sản phẩm đã mua</h1>
  <h2><%= item.product_name %></h2>
  <% if (item.variant_name) { %><p>Phiên bản lúc mua: <%= item.variant_name %></p><% } %>
  <% if (review) { %>
    <p class="account-notice" role="status">Đã ghi nhận đánh giá của bạn cho sản phẩm này. Mỗi sản phẩm chỉ được đánh giá một lần.</p>
    <p>Điểm: <strong><%= review.rating %>/5</strong> · <%= review.created_at_label %></p>
    <p class="review-comment"><%= review.comment || 'Không có nội dung nhận xét.' %></p>
  <% } else { %>
    <p>Đánh giá theo trải nghiệm của bạn. Điểm bắt buộc từ 1 đến 5; nội dung nhận xét không bắt buộc.</p>
    <form method="post" action="<%= action %>" class="profile_form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <label for="review-rating">Điểm đánh giá</label>
      <select id="review-rating" name="rating" required aria-describedby="rating-error">
        <option value="">Chọn điểm</option>
        <% for (let score = 1; score <= 5; score++) { %><option value="<%= score %>" <%= values.rating === String(score) ? 'selected' : '' %>><%= score %>/5</option><% } %>
      </select>
      <p id="rating-error" class="account-error" role="alert"><%= errors.rating || '' %></p>
      <label for="review-comment">Nội dung nhận xét (tối đa 2.000 ký tự)</label>
      <textarea id="review-comment" name="comment" rows="5" maxlength="2000" aria-describedby="comment-error"><%= values.comment || '' %></textarea>
      <p id="comment-error" class="account-error" role="alert"><%= errors.comment || '' %></p>
      <button type="submit" class="btn btn--primary">Gửi đánh giá</button>
    </form>
  <% } %>
  <p><a href="/orders/<%= orderId %>">Về chi tiết đơn hàng</a> · <a href="/products/<%= item.product_id %>/reviews">Xem đánh giá sản phẩm</a></p>
</section>
<%- include('../account/partials/end') %>
