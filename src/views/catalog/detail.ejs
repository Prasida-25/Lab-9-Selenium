<%- include('partials/head') %>
<link rel="stylesheet" href="/css/product-detail.css" />
<% const imageBase = `/products/${product.product_id}`;
   const selectedImage = `${imageBase}${selected ? `/variants/${selected.variant_id}` : ''}/image`;
   const canBuy = selected && Number(selected.stock) > 0 && Number(selected.price) > 0;
%>
<div class="container"><main class="grid app__content product-page">
  <nav class="catalog-breadcrumb" aria-label="Đường dẫn">
    <a href="/">Trang chủ</a> / <a href="/products">Sản phẩm</a>
    <% if (product.category_id) { %> / <a href="/products?category_id=<%= product.category_id %>"><%= product.category_name %></a><% } %>
  </nav>
  <article class="catalog-detail product-overview">
    <div class="product-gallery" aria-label="Hình ảnh sản phẩm">
      <div class="product-gallery__stage">
        <img id="product-main-image" src="<%= selectedImage %>" alt="<%= product.product_name %><%= selected ? ` — ${selected.variant_name}` : '' %>" width="500" height="500" fetchpriority="high" />
      </div>
      <div class="product-gallery__thumbnails" aria-label="Chọn ảnh sản phẩm">
        <a class="product-thumbnail" href="<%= imageBase %>/image" data-gallery-image aria-label="Xem ảnh tổng quan" aria-current="<%= selected ? 'false' : 'true' %>">
          <img src="<%= imageBase %>/image" alt="<%= product.product_name %> — Tổng quan" width="72" height="72" />
        </a>
        <% for (const [index, image] of (product.images || []).entries()) { %>
          <a class="product-thumbnail" href="<%= imageBase %>/images/<%= image.image_id %>" data-gallery-image aria-label="Xem ảnh bổ sung <%= index + 1 %>" aria-current="false">
            <img src="<%= imageBase %>/images/<%= image.image_id %>" alt="<%= product.product_name %> — Ảnh bổ sung <%= index + 1 %>" width="72" height="72" loading="lazy" />
          </a>
        <% } %>
        <% for (const variant of product.variants) { %>
          <a class="product-thumbnail" href="<%= imageBase %>/variants/<%= variant.variant_id %>/image" data-gallery-image aria-label="Xem ảnh <%= variant.variant_name %>" aria-current="<%= selected && Number(selected.variant_id) === Number(variant.variant_id) ? 'true' : 'false' %>">
            <img src="<%= imageBase %>/variants/<%= variant.variant_id %>/image" alt="<%= product.product_name %> — <%= variant.variant_name %>" width="72" height="72" loading="lazy" />
          </a>
        <% } %>
      </div>
    </div>
    <div class="catalog-detail__info">
      <h1><%= product.product_name %></h1>
      <a class="product-review-link" href="#product-reviews">Xem đánh giá từ khách đã mua</a>
      <% if (selected) { %>
        <div class="product-price-panel">
          <% if (Number(selected.price) > 0) { %><p class="catalog-detail__price" id="variant-price"><%= formatMoney(selected.price) %></p>
          <% } else { %><p class="product-unavailable">Phiên bản chưa có giá bán hợp lệ.</p><% } %>
        </div>
        <div class="product-shipping"><i class="fa-solid fa-truck-fast" aria-hidden="true"></i><div><strong>Thông tin vận chuyển</strong><p>Miễn phí cho đơn từ 300.000đ.</p><p>Thanh toán khi nhận hàng.</p></div></div>
        <form method="get" action="/products/<%= product.product_id %>" id="variant-form">
          <label for="variant-select">Phiên bản</label>
          <select name="variant" id="variant-select">
            <% for (const variant of product.variants) { const labels = product.options.filter((option) => Number(option.variant_id) === Number(variant.variant_id)); %>
              <option value="<%= variant.variant_id %>" <%= Number(selected.variant_id) === Number(variant.variant_id) ? 'selected' : '' %>><%= variant.variant_name %><%= labels.length ? ' — ' + labels.map((option) => `${option.option_name}: ${option.value_name}`).join(', ') : '' %><%= Number(variant.stock) === 0 ? ' — Hết hàng' : '' %></option>
            <% } %>
          </select>
          <button class="btn product-variant-submit" type="submit">Xem phiên bản</button>
        </form>
        <p class="product-stock"><span class="product-field-label">Tình trạng</span><strong id="variant-stock"><%= Number(selected.stock) > 0 ? `Còn hàng (${selected.stock})` : 'Hết hàng' %></strong></p>
        <% if (canBuy) { %>
          <form method="post" action="/cart/items" class="product-purchase">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="variant_id" value="<%= selected.variant_id %>" />
            <input type="hidden" name="returnTo" value="/products/<%= product.product_id %>?variant=<%= selected.variant_id %>" />
            <div class="product-quantity-row"><label for="cart-quantity" class="product-field-label">Số lượng</label>
              <div class="product-quantity">
                <button type="button" data-quantity-step="-1" aria-label="Giảm số lượng" disabled>−</button>
                <input id="cart-quantity" type="number" name="quantity" min="1" max="<%= Math.min(99, Number(selected.stock)) %>" value="1" step="1" inputmode="numeric" required />
                <button type="button" data-quantity-step="1" aria-label="Tăng số lượng">+</button>
              </div>
            </div>
            <div class="product-purchase__buttons">
              <button type="submit" class="btn product-add-button"><i class="fa-solid fa-cart-plus" aria-hidden="true"></i> Thêm vào giỏ hàng</button>
              <button type="submit" class="btn product-buy-button" formaction="/cart/buy-now">Mua ngay</button>
            </div>
          </form>
        <% } else { %><p class="product-unavailable">Phiên bản này hiện chưa thể đặt mua.</p><% } %>
      <% } else { %>
        <p class="catalog-empty">Chưa có biến thể hợp lệ. Chưa có giá bán.</p>
      <% } %>
    </div>
  </article>
  <section class="product-section" aria-labelledby="product-details-heading">
    <h2 id="product-details-heading">Chi tiết sản phẩm</h2>
    <dl class="product-facts">
      <dt>Danh mục</dt><dd><% if (product.category_id) { %><a href="/products?category_id=<%= product.category_id %>"><%= product.category_name %></a><% } else { %>Chưa phân loại<% } %></dd>
      <dt>Thương hiệu</dt><dd><%= product.brand || 'Chưa có thông tin' %></dd>
      <% if (selected) { %><dt>Phiên bản</dt><dd><%= selected.variant_name %></dd><dt>Mã phiên bản</dt><dd><%= selected.sku %></dd><% } %>
    </dl>
  </section>
  <section class="product-section product-description" aria-labelledby="product-description-heading"><h2 id="product-description-heading">Mô tả sản phẩm</h2><p><%= product.description || 'Chưa có mô tả sản phẩm.' %></p></section>
  <section class="product-section product-reviews" id="product-reviews" aria-labelledby="product-reviews-heading">
    <h2 id="product-reviews-heading">Đánh giá của người mua</h2>
    <% if (!productReviews.reviews.length) { %>
      <p role="status">Chưa có đánh giá cho sản phẩm này.</p>
    <% } else { %>
      <% for (const review of productReviews.reviews) { %>
        <article class="product-buyer-review">
          <h3 class="product-buyer-review__name"><%= review.buyer_name || 'Khách đã mua hàng' %></h3>
          <div class="product-buyer-review__rating" role="img" aria-label="<%= review.rating %> trên 5 sao"><% for (let star = 1; star <= 5; star++) { %><span class="<%= star <= Number(review.rating) ? 'is-filled' : '' %>" aria-hidden="true">★</span><% } %></div>
          <p class="product-buyer-review__date"><%= review.created_at_label %></p>
          <p class="product-buyer-review__comment"><%= review.comment || 'Không có nội dung nhận xét.' %></p>
        </article>
      <% } %>
      <% if (productReviews.total > productReviews.reviews.length) { %><p><a class="product-review-link" href="<%= imageBase %>/reviews">Xem tất cả đánh giá</a></p><% } %>
    <% } %>
  </section>
</main></div>
<script src="/js/product-details.js" defer></script>
<%- include('partials/end') %>
