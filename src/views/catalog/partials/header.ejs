<header class="header">
        <div class="grid">
          <nav class="header__navbar">
            <ul class="header__navbar-list">
              <li
                class="header__navbar-items header__navbar-items--has-qr header__navbar-items-separate"
              >
                Vào cửa hàng trên ứng dụng
                <div class="header__qr">
                  <img
                    src="/images/QR.png"
                    alt=""
                    class="header__qr-img"
                  />
                </div>
              </li>
              <li class="header__navbar-items">
                <span class="header__navbar--tittle-no-pointer">Kết nối</span>
                <a href="facebook" class="header__navbar-icon-link"
                  ><i class="header__navbar-icon fab fa-facebook"></i
                ></a>
                <a href="instagram" class="header__navbar-icon-link"
                  ><i class="header__navbar-icon fab fa-instagram"></i
                ></a>
              </li>
            </ul>

            <ul class="header__navbar-list">
              <li class="header__navbar-items header__navbar-items--has-notify">
                <a class="header__navbar-items-link" href="#">
                  <i class="header__navbar-icon far fa-question-circle"></i>
                  Hỗ trợ
                </a>
                <div class="header__notify">
                  <header class="header__notify-header">
                    <h3
                      style="
                        color: var(--text-color);
                        margin: 0 0 0 12px;
                        font-weight: 500;
                        font-size: 1.6rem;
                        line-height: 40px;
                        user-select: none;
                      "
                    >
                      Hotline: 1900 1221
                    </h3>
                  </header>
                </div>
              </li>
              <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <li class="header__navbar-items header__navbar-items-strong header__navbar-items-separate">
                   <a class="header__navbar-items-link" href="<%= currentUser.role === 'admin' ? '/admin' : '/account' %>"><%= currentUser.role === 'admin' ? 'Quản trị' : 'Tài khoản' %></a>
                </li>
                 <% if (currentUser.role !== 'admin') { %><li class="header__navbar-items header__navbar-items-strong"><a class="header__navbar-items-link" href="/orders">Đơn mua</a></li><% } %>
                <li class="header__navbar-items header__navbar-items-strong">
                  <form method="post" action="/logout" class="header-auth-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="header-auth-button" type="submit">Đăng xuất</button>
                  </form>
                </li>
              <% } else { %>
                <li class="header__navbar-items header__navbar-items-strong header__navbar-items-separate">
                  <a href="/register" class="header__navbar-items-link">Đăng ký</a>
                </li>
                <li class="header__navbar-items header__navbar-items-strong">
                  <a href="/login" class="header__navbar-items-link">Đăng nhập</a>
                </li>
              <% } %>
            </ul>
          </nav>

          <div class="header-with-search">
            <div class="header__logo"><a href="/" aria-label="Trang chủ TechZone">
              <svg
                class="header__logo-img"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 150 40"
                width="150"
                height="40"
                role="img"
                aria-label="TechZone"
                xmlns:c2pa="http://c2pa.org/manifest"
              >
                <metadata>
                  <c2pa:manifest
                    ></c2pa:manifest
                  >
                </metadata>
                <title>TechZone</title>
                <g
                  fill="none"
                  stroke="#33CC33"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M9 13.5h14a2.5 2.5 0 0 1 2.5 2.5l1 14a3 3 0 0 1-3 3.2H8.5a3 3 0 0 1-3-3.2l1-14A2.5 2.5 0 0 1 9 13.5z"
                  />
                  <path d="M11.5 13.5V12a4.5 4.5 0 0 1 9 0v1.5" />
                  <path d="M11.5 19.5v1a4.5 4.5 0 0 0 9 0v-1" />
                </g>
                <text
                  x="36"
                  y="27.5"
                  fill="#FFFFFF"
                  font-family="'Segoe UI', 'Poppins', 'Inter', Arial, Helvetica, sans-serif"
                  font-size="20"
                  font-weight="700"
                  letter-spacing="-0.3"
                >
                  TechZone
                </text>
              </svg>
            </a></div>
            <% if (typeof cartPage !== 'undefined' && cartPage) { %><h1 class="cart-header-title">Giỏ hàng</h1><% } %>

            <form class="header__search" action="/products/search" method="get" role="search">
              <div class="header__search-input-wrap">
                <input
                  type="text"
                  class="header__search-input" name="q" value="<%= filters.q || '' %>" maxlength="200" aria-label="Tìm kiếm sản phẩm"
                  placeholder="Nhập để tìm kiếm sản phẩm"
                />
                
              </div>

              <% for (const [name, value] of Object.entries({category_id: filters.categoryId, min_price: filters.minPrice, max_price: filters.maxPrice, sort: filters.sort, limit: filters.limit})) { if (value !== undefined && value !== null && value !== '') { %><input type="hidden" name="<%= name %>" value="<%= value %>" /><% } } %><button class="header__search-btn" type="submit" aria-label="Tìm kiếm">
                <i class="header__search-btn-icon fas fa-search"></i>
              </button>
            </form>
            <div class="header__cart">
              <div class="header__cart-wrap" data-header-cart data-authenticated="<%= currentUser ? '1' : '0' %>">
                <a href="/cart" class="header__cart-link" aria-label="Xem giỏ hàng" aria-expanded="false" aria-controls="header-cart-preview">
                  <i class="header__cart-icon fas fa-shopping-cart"></i>
                  <span class="header-cart-badge" data-cart-badge hidden></span>
                </a>
                <div id="header-cart-preview" class="header__cart-list header__cart-list--preview" role="region" aria-label="Xem nhanh sản phẩm trong giỏ">
                  <h3>Sản phẩm trong giỏ</h3>
                  <div data-cart-preview-body aria-live="polite">
                    <p class="header-cart-state"><%= currentUser ? 'Đang tải giỏ hàng…' : 'Đăng nhập để xem giỏ hàng của bạn.' %></p>
                  </div>
                  <div class="header-cart-footer">
                    <a class="btn btn--primary" href="<%= currentUser ? '/cart' : '/login?returnTo=%2Fcart' %>"><%= currentUser ? 'Mở giỏ hàng' : 'Đăng nhập' %></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>
