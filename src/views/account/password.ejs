<%- include('partials/start') %>
<section class="profile">
  <header class="account-panel-header"><h1 class="profile_heading">Đổi mật khẩu</h1><p>Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu với người khác.</p></header>
  <% if (errors.general) { %><p class="account-error" role="alert"><%= errors.general %></p><% } %>
  <form class="profile_form" method="post" action="/account/change-password" data-account-form="password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <%- include('partials/field', {field: 'current_password', label: 'Mật khẩu hiện tại', inputType: 'password', maximum: 128, values: {}}) %>
    <%- include('partials/field', {field: 'new_password', label: 'Mật khẩu mới', inputType: 'password', maximum: 128, values: {}}) %>
    <p class="profile__hint">Mật khẩu mới từ 8–128 ký tự, có chữ cái và chữ số.</p>
    <%- include('partials/field', {field: 'confirm_password', label: 'Xác nhận mật khẩu', inputType: 'password', maximum: 128, values: {}}) %>
    <div class="account-form-submit"><button class="profile__save" type="submit">Đổi mật khẩu</button></div>
  </form>
</section>
<%- include('partials/end') %>
